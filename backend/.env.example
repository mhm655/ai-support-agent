# Optional: email the business owner when their agent captures a lead.
# Leave unset and notifications are simply off; nothing else changes.
# Any SMTP service works. For a free option with no card, a Gmail address
# with an App Password (Google Account > Security > 2-Step Verification >
# App passwords) needs no domain and no signup.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=you@gmail.com
# SMTP_PASSWORD=your-16-char-app-password
# SMTP_FROM=you@gmail.com
# DASHBOARD_BASE_URL=https://your-app.vercel.app

