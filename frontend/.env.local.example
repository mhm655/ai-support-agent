# Supabase — Project Settings > API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Your FastAPI backend
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional — powers /demo. The agent_id of a pre-seeded, publicly chattable
# agent (public_chat.py is unauthenticated by design; see ARCHITECTURE.md).
# Leave unset locally; /demo just shows a "not configured" message.
NEXT_PUBLIC_DEMO_AGENT_ID=
